# Microsoft Entra ID (Azure AD) — required for the agent365 MCP servers.
# Directory (tenant) ID
MSFT_TENANT_ID=c22abd1a-1bc9-4247-bca0-25abef95f417
# App registration -> Application (client) ID
MSFT_CLIENT_ID=c22abd1a-1bc9-4247-bca0-25abef95f417
# App registration -> Certificates & secrets -> client secret VALUE (not the ID)
MSFT_CLIENT_SECRET=c22abd1a-1bc9-4247-bca0-25abef95f417

# Optional: the resource "/.default" scope. Defaults to
# https://agent365.svc.cloud.microsoft/.default — override if your tenant
# exposes the resource under a different app ID URI (e.g. api://<guid>/.default).
# MSFT_MCP_SCOPE=https://agent365.svc.cloud.microsoft/.default
